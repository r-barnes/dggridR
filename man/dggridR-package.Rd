 \code{\link[=dgGEO_to_SEQNUM]{dgGEO_to_SEQNUM()}} --- Geographic coordinates to cell sequence number\cr
 \code{\link[=dgSEQNUM_to_GEO]{dgSEQNUM_to_GEO()}} --- Cell sequence number to geographic coordinates\cr


